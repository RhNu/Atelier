{
  "name": "atelier",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "desktop:dev": "pnpm --dir apps/desktop exec tauri dev",
    "desktop:build": "pnpm --dir apps/desktop exec tauri build",
    "build": "pnpm --dir apps/desktop build",
    "fmt": "pnpm --dir apps/desktop fmt && node apps/desktop/node_modules/oxfmt/bin/oxfmt scripts/release .github/workflows",
    "fmt:check": "pnpm --dir apps/desktop fmt:check && node apps/desktop/node_modules/oxfmt/bin/oxfmt --check scripts/release .github/workflows",
    "lint": "pnpm --dir apps/desktop lint && pnpm release:lint",
    "test": "pnpm --dir apps/desktop test && pnpm release:test",
    "release:lint": "node apps/desktop/node_modules/oxlint/bin/oxlint --deny-warnings scripts/release",
    "release:test": "node --test scripts/release/*.test.mjs",
    "typecheck": "pnpm --dir apps/desktop typecheck",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy-strict",
    "rust:clippy:strict": "cargo clippy-strict",
    "rust:test": "cargo test --workspace",
    "rust:line-budget": "cargo xtask line-budget"
  }
}
