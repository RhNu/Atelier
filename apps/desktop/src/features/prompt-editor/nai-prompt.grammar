@top Prompt { Item* }

Item {
  ExtensionCall |
  Randomizer |
  NumericEmphasis |
  Strengthening |
  Weakening |
  CloseAll |
  Pipe |
  Comma |
  Escaped |
  String |
  Tag |
  Number |
  Identifier |
  Text
}

Strengthening { LBrace Item* RBrace }
Weakening { LBracket Item* RBracket }
NumericEmphasis { Number !numeric DoubleColon NumericContent* DoubleColon }
NumericContent { ExtensionCall | Randomizer | Strengthening | Weakening | Pipe | Comma | Escaped | String | Tag | Number | Identifier | Text }
Randomizer { DoublePipe RandomizerContent* DoublePipe }
RandomizerContent { ExtensionCall | Strengthening | Weakening | NumericEmphasis | Pipe | Comma | Escaped | String | Tag | Number | Identifier | Text }
ExtensionCall { Dollar Identifier LParen ExtensionItem* RParen }
ExtensionItem { String | Tag | Number | Identifier | Equals | Comma | Escaped | Pipe | Text }
CloseAll { DoubleColon }

@tokens {
  whitespace { std.whitespace+ }
  DoublePipe { "||" }
  DoubleColon { "::" }
  LBrace { "{" }
  RBrace { "}" }
  LBracket { "[" }
  RBracket { "]" }
  LParen { "(" }
  RParen { ")" }
  Comma { "," }
  Pipe { "|" }
  Dollar { "$" }
  Equals { "=" }
  Escaped { "\\" ![\n\r] }
  String { '"' ("\\" ![\n\r] | !["\\])* '"' }
  Tag { @digit+ ( @asciiLetter | @digit | "_" | "-" )+ }
  Number { "-"? @digit+ ("." @digit+)? }
  Identifier { @asciiLetter ( @asciiLetter | @digit | "_" | "-" )* }
  Text { ![{}\[\](),|@$=:"\\ \t\n\r]+ | ":" }
  @precedence { DoublePipe, DoubleColon, String, Tag, Number, Identifier, Escaped, whitespace, Text }
}

@skip { whitespace }

@precedence { numeric @left }
