@top Prompt { Item* }

Item {
  ExtensionCall |
  Randomizer |
  NumericEmphasis |
  Strengthening |
  Weakening |
  CloseAll |
  Pipe |
  Comma |
  Escaped |
  String |
  UnterminatedString |
  Tag |
  InvalidNumber |
  Number |
  Identifier |
  LParen |
  RParen |
  Dollar |
  Equals |
  Text
}

Strengthening { LBrace Item* RBrace }
Weakening { LBracket Item* RBracket }
NumericEmphasis {
  Number !numeric DoubleColon NumericContent* DoubleColon |
  InvalidNumber !numeric DoubleColon NumericContent* DoubleColon
}
NumericContent { ExtensionCall | Randomizer | Strengthening | Weakening | Pipe | Comma | Escaped | String | UnterminatedString | Tag | InvalidNumber | Number | Identifier | LParen | RParen | Dollar | Equals | Text }
Randomizer { DoublePipe RandomizerContent* DoublePipe }
RandomizerContent { ExtensionCall | Strengthening | Weakening | NumericEmphasis | Pipe | Comma | Escaped | String | Tag | Number | Identifier | Text }
ExtensionCall { Dollar !extension Identifier LParen ExtensionItem* RParen }
ExtensionItem { String | UnterminatedString | Tag | InvalidNumber | Number | Identifier | Equals | Comma | Escaped | DoublePipe | DoubleColon | LBrace | RBrace | LBracket | RBracket | Pipe | Text }
CloseAll { DoubleColon }

@tokens {
  whitespace { std.whitespace+ }
  DoublePipe { "||" }
  DoubleColon { "::" }
  LBrace { "{" }
  RBrace { "}" }
  LBracket { "[" }
  RBracket { "]" }
  LParen { "(" }
  RParen { ")" }
  Comma { "," }
  Pipe { "|" }
  Dollar { "$" }
  Equals { "=" }
  Escaped { "\\" ![\n\r] }
  String { '"' ("\\" ![\n\r] | !["\\])* '"' }
  UnterminatedString { '"' ("\\" ![\n\r] | !["\\])* }
  Tag { @digit+ ( @asciiLetter | @digit | "_" | "-" )+ }
  InvalidNumber { "-"? @digit+ "." @digit* "." ( @digit | "." )* }
  Number { "-"? @digit+ ("." @digit+)? }
  Identifier { @asciiLetter ( @asciiLetter | @digit | "_" | "-" )* }
  Text { ![{}\[\](),|@$=:"\\ \t\n\r]+ | ":" }
  @precedence { DoublePipe, DoubleColon, String, UnterminatedString, Tag, InvalidNumber, Number, Identifier, Escaped, whitespace, Text }
}

@skip { whitespace }

@precedence { extension @right, numeric @left }
